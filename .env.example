HOST=0.0.0.0
PORT=3000

# PostgreSQL Configuration (PostgreSQL 16)
POSTGRES_USER=elephant_admin
POSTGRES_PASSWORD=SuperSecureAndComplexPassword2026!
POSTGRES_DB=elephant_messenger
POSTGRES_PORT=42359
POSTGRES_HOST=127.0.0.1

# JWT
JWT_SECRET=my_super_long_and_secure_secret_key

# Cryptography Parameters
ARGON_MEMORY=65536
ARGON_ITERATIONS=3
ARGON_PARALLELISM=2

# How many password hashes may run at once. Each uses ARGON_MEMORY of RAM, so this
# bounds the memory a burst of sign-ins can take. Extra requests wait their turn.
ARGON_MAX_CONCURRENT=2

# How sign-in/sign-up rate limits find a client's address behind a reverse proxy:
# auto (trust X-Forwarded-For only from a private/loopback proxy), 0 (never), or the
# number of proxies in front of the server. Use 0 if the server is exposed directly.
TRUSTED_PROXY_HOPS=auto

# Apply pending database migrations when the server starts (set to false to manage them yourself)
AUTO_MIGRATE=true

# OAuth2 Authentication Providers
# Google Developer Console Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# GitHub Developer Settings Credentials
GITHUB_CLIENT_ID=ov-your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:3000/api/auth/github/callback

# Who can create accounts: "open" (default) or "closed". Existing users can still sign in.
REGISTRATION=open

# Allow UnifiedPush endpoints on private/loopback addresses over plain HTTP (e.g. ntfy on your LAN). Leave false unless you need it.
PUSH_ALLOW_PRIVATE_ENDPOINTS=false
